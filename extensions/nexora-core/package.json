{
  "name": "nexora-core",
  "displayName": "Nexora Core",
  "description": "Universal AI Orchestration System - Core Extension",
  "version": "1.0.0",
  "publisher": "nexora-team",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexora-sidebar",
          "title": "Nexora AI",
          "icon": "media/nexora-icon.svg"
        }
      ]
    },
    "views": {
      "nexora-sidebar": [
        {
          "type": "webview",
          "id": "nexora.chatPanel",
          "name": "Nexora Chat",
          "visibility": "visible"
        },
        {
          "type": "webview",
          "id": "nexora.workflowViewer",
          "name": "Workflow",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "nexora.outputViewer",
          "name": "Output",
          "visibility": "collapsed"
        },
        {
          "id": "nexora.taskTree",
          "name": "Task Plan",
          "visibility": "collapsed"
        },
        {
          "id": "nexora.platformBrowser",
          "name": "Platform Browser",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "nexora.settings",
          "name": "Settings",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "nexora.openChat",
        "title": "Open Nexora Chat",
        "category": "Nexora"
      },
      {
        "command": "nexora.openTaskPlan",
        "title": "Open Nexora Task Plan",
        "category": "Nexora"
      },
      {
        "command": "nexora.openPlatformBrowser",
        "title": "Open Nexora Platform Browser",
        "category": "Nexora"
      },
      {
        "command": "nexora.refreshPlatforms",
        "title": "Refresh Platforms",
        "category": "Nexora",
        "icon": "$(refresh)"
      },
      {
        "command": "nexora.checkBackend",
        "title": "Check Backend Connection",
        "category": "Nexora"
      },
      {
        "command": "nexora.decomposeRequest",
        "title": "Plan Tasks",
        "category": "Nexora",
        "icon": "$(list-tree)"
      },
      {
        "command": "nexora.clearTasks",
        "title": "Clear Task Plan",
        "category": "Nexora",
        "icon": "$(clear-all)"
      },
      {
        "command": "nexora.showTaskOutput",
        "title": "Show Task Output",
        "category": "Nexora"
      },
      {
        "command": "nexora.openWorkflow",
        "title": "Open Workflow Viewer",
        "category": "Nexora"
      },
      {
        "command": "nexora.openOutput",
        "title": "Open Output Viewer",
        "category": "Nexora"
      },
      {
        "command": "nexora.newSession",
        "title": "New Chat Session",
        "category": "Nexora"
      },
      {
        "command": "nexora.cancelOperation",
        "title": "Cancel Current Operation",
        "category": "Nexora"
      },
      {
        "command": "nexora.openSettings",
        "title": "Open Settings",
        "category": "Nexora"
      },
      {
        "command": "nexora.showKeyboardShortcuts",
        "title": "Show Keyboard Shortcuts",
        "category": "Nexora"
      },
      {
        "command": "nexora.refreshSettings",
        "title": "Refresh Settings Status",
        "category": "Nexora"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nexora.refreshPlatforms",
          "when": "view == nexora.platformBrowser",
          "group": "navigation"
        },
        {
          "command": "nexora.decomposeRequest",
          "when": "view == nexora.taskTree",
          "group": "navigation"
        },
        {
          "command": "nexora.clearTasks",
          "when": "view == nexora.taskTree",
          "group": "navigation"
        },
        {
          "command": "nexora.refreshSettings",
          "when": "view == nexora.settings",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nexora.openChat",
        "key": "ctrl+alt+i",
        "mac": "cmd+ctrl+i"
      },
      {
        "command": "nexora.openChat",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "!terminalFocus"
      },
      {
        "command": "nexora.newSession",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      },
      {
        "command": "nexora.cancelOperation",
        "key": "escape",
        "when": "nexora.operationInProgress"
      },
      {
        "command": "nexora.openSettings",
        "key": "ctrl+alt+,",
        "mac": "cmd+alt+,"
      },
      {
        "command": "nexora.showKeyboardShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/copyWebviewAssets.js",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ws": "^8.20.0"
  }
}